# Postgres (usado por docker-compose y por apps/api)
POSTGRES_USER=chess
POSTGRES_PASSWORD=chess
POSTGRES_DB=chess_move_reader

# apps/api (Spring Boot) -- solo hacen falta si corres apps/api FUERA de Docker
# (mvnw spring-boot:run en el host); dentro de docker-compose estas variables las
# construye el propio compose file a partir de las de Postgres de arriba.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/chess_move_reader
SPRING_DATASOURCE_USERNAME=chess
SPRING_DATASOURCE_PASSWORD=chess
STORAGE_DIR=./data/uploads
MAX_UPLOAD_MB=10
# Lista separada por comas (a diferencia del array JSON que usaba el backend Python).
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201

# Secreto de firma JWT -- OBLIGATORIO para docker-compose (falla el arranque si
# falta, a propósito). Genera uno de verdad con: openssl rand -base64 32
JWT_SECRET=

# "mock" (partida de ejemplo, no requiere API key) o "http" (delega a apps/ocr)
OCR_CLIENT=mock
# Solo se usa si corres `apps/api` fuera de Docker (Maven en el host). Dentro de
# docker-compose, api ignora esta variable y usa el hostname interno "ocr" siempre.
OCR_SERVICE_URL=http://localhost:8001

# apps/ocr -- solo hace falta si OCR_CLIENT=http
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
